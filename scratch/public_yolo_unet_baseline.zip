{"metadata":{"languageNullable":"python","kernelTypeNullable":"notebook","isPrivateNullable":false,"enableGpuNullable":true,"enableTpuNullable":false,"enableInternetNullable":true,"currentVersionNumberNullable":1,"dockerImageNullable":"gcr.io/kaggle-private-byod/python@sha256:37c64f7dd9c54116ecd1bcc88817c5469b88387388fade02bfa8bf3fc647d461","machineShapeNullable":"NvidiaTeslaT4","id":128103814,"ref":"ektarr/yolo-u-net-solar-filament-segmentation","title":"YOLO + U-Net | Solar Filament Segmentation","author":"Maxim","slug":"yolo-u-net-solar-filament-segmentation","lastRunTime":"2026-08-10T10:01:57.5092037Z","language":"python","hasLanguage":true,"kernelType":"notebook","hasKernelType":true,"isPrivate":false,"hasIsPrivate":true,"enableGpu":true,"hasEnableGpu":true,"enableTpu":false,"hasEnableTpu":true,"enableInternet":true,"hasEnableInternet":true,"categoryIds":["gpu"],"datasetDataSources":[],"kernelDataSources":[],"competitionDataSources":["filament-segmentation-2026"],"modelDataSources":[],"totalVotes":21,"currentVersionNumber":1,"hasCurrentVersionNumber":true,"dockerImage":"gcr.io/kaggle-private-byod/python@sha256:37c64f7dd9c54116ecd1bcc88817c5469b88387388fade02bfa8bf3fc647d461","hasDockerImage":true,"machineShape":"NvidiaTeslaT4","hasMachineShape":true},"blob":{"sourceNullable":"{\u0022metadata\u0022:{\u0022kernelspec\u0022:{\u0022display_name\u0022:\u0022Python 3\u0022,\u0022language\u0022:\u0022python\u0022,\u0022name\u0022:\u0022python3\u0022},\u0022language_info\u0022:{\u0022name\u0022:\u0022python\u0022,\u0022version\u0022:\u00223.12.13\u0022,\u0022mimetype\u0022:\u0022text/x-python\u0022,\u0022codemirror_mode\u0022:{\u0022name\u0022:\u0022ipython\u0022,\u0022version\u0022:3},\u0022pygments_lexer\u0022:\u0022ipython3\u0022,\u0022nbconvert_exporter\u0022:\u0022python\u0022,\u0022file_extension\u0022:\u0022.py\u0022}},\u0022nbformat_minor\u0022:4,\u0022nbformat\u0022:4,\u0022cells\u0022:[{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022%pip install -q ultralytics\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:15.487107Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:15.487377Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:21.328202Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:15.487343Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:21.327099Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Imports\\n# ====================================================\\n\\nimport os\\nimport json\\nimport random\\nimport warnings\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom sklearn.model_selection import train_test_split\\nfrom tqdm.auto import tqdm\\n\\nimport torch\\nfrom ultralytics import YOLO\\nfrom pycocotools import mask as mask_utils\\n\\nwarnings.filterwarnings(\\\u0022ignore\\\u0022)\\n\\nimport ultralytics.utils.tqdm as ultra_tqdm\\nultra_tqdm.is_noninteractive_console = lambda: True\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:21.330302Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:21.330544Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.273106Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:21.330516Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.272464Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Config\\n# ====================================================\\n\\nclass CFG:\\n\\n    ROOT = \\\u0022/kaggle/input/competitions/filament-segmentation-2026/MAGFiLO_1.0_Kaggle_2026\\\u0022\\n\\n    TRAIN_DIR = os.path.join(ROOT, \\\u0022train\\\u0022, \\\u0022train_images\\\u0022)\\n    TEST_DIR = os.path.join(ROOT, \\\u0022test\\\u0022, \\\u0022test_images\\\u0022)\\n\\n    TRAIN_JSON = os.path.join(\\n        ROOT,\\n        \\\u0022train\\\u0022,\\n        \\\u0022MAGFiLO_1.0_Annotations_kaggle2026_train.json\\\u0022\\n    )\\n\\n    YOLO_DIR = \\\u0022/kaggle/working/yolo_dataset\\\u0022\\n\\n    DEVICE = 0 if torch.cuda.is_available() else \\\u0022cpu\\\u0022\\n    DEBUG = False\\n\\n    IMGSZ = 1024\\n    BATCH_SIZE = 4\\n    EPOCHS = 1 if DEBUG else 30\\n    PATIENCE = 5\\n\\n    MODEL = \\\u0022yolo11s-seg.pt\\\u0022\\n\\n    USE_CATEGORIES = True\\n\\n    MASK_RATIO = 2\\n\\n    CONF_THRESHOLD = 0.25\\n    MIN_COMPONENT_SIZE = 20\\n\\n    SEED = 42\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.274101Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.27456Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.539601Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.274535Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.538606Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Seed\\n# ====================================================\\n\\ndef seed_everything(seed):\\n    random.seed(seed)\\n    np.random.seed(seed)\\n    torch.manual_seed(seed)\\n    if torch.cuda.is_available():\\n        torch.cuda.manual_seed_all(seed)\\n\\n\\nseed_everything(CFG.SEED)\\n\\nprint(f\\\u0022Device: {CFG.DEVICE}\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.54107Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.541467Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.559706Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.541445Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.558853Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# COCO -\u003e YOLO-seg conversion\\n# ====================================================\\n\\nwith open(CFG.TRAIN_JSON, \\\u0022r\\\u0022) as f:\\n    coco = json.load(f)\\n\\nimages = {img[\\\u0022id\\\u0022]: img for img in coco[\\\u0022images\\\u0022]}\\n\\nannotations = {}\\n\\nfor ann in coco[\\\u0022annotations\\\u0022]:\\n    annotations.setdefault(ann[\\\u0022image_id\\\u0022], []).append(ann)\\n\\nfile_to_ids = {}\\n\\nfor image_id, info in images.items():\\n    file_to_ids.setdefault(info[\\\u0022file_name\\\u0022], []).append(image_id)\\n\\nunique_files = list(file_to_ids.keys())\\n\\ndef observation_completeness(image_id):\\n    anns = annotations.get(image_id, [])\\n    total_area = sum(ann.get(\\\u0022area\\\u0022, 0) for ann in anns)\\n    return (len(anns), total_area)\\n\\nfile_to_best_id = {\\n    file_name: max(ids, key=observation_completeness)\\n    for file_name, ids in file_to_ids.items()\\n}\\n\\nn_duplicated = sum(1 for ids in file_to_ids.values() if len(ids) \u003e 1)\\nprint(f\\\u0022Instances with multiple labelers: \\\u0022\\n      f\\\u0022{n_duplicated} / {len(file_to_ids)}\\\u0022)\\n\\nunique_files = list(file_to_best_id.keys())\\n\\ntrain_files, valid_files = train_test_split(\\n    unique_files,\\n    test_size=0.2,\\n    random_state=CFG.SEED\\n)\\n\\ntrain_ids = [file_to_best_id[f] for f in train_files]\\nvalid_ids = [file_to_best_id[f] for f in valid_files]\\n\\nprint(f\\\u0022Train images: {len(train_ids)}\\\u0022)\\nprint(f\\\u0022Valid images: {len(valid_ids)}\\\u0022)\\n\\n\\nif CFG.USE_CATEGORIES and \\\u0022categories\\\u0022 in coco and coco[\\\u0022categories\\\u0022]:\\n\\n    categories = sorted(coco[\\\u0022categories\\\u0022], key=lambda c: c[\\\u0022id\\\u0022])\\n    cat_id_to_yolo = {c[\\\u0022id\\\u0022]: i for i, c in enumerate(categories)}\\n    class_names = [c[\\\u0022name\\\u0022] for c in categories]\\n\\nelse:\\n\\n    cat_id_to_yolo = None\\n    class_names = [\\\u0022filament\\\u0022]\\n\\nprint(\\\u0022Classes:\\\u0022, class_names)\\n\\n\\ndef coco_polygon_to_yolo_line(polygon, w, h, cls_id):\\n\\n    pts = np.array(polygon, dtype=np.float32).reshape(-1, 2)\\n\\n    pts[:, 0] = np.clip(pts[:, 0] / w, 0, 1)\\n    pts[:, 1] = np.clip(pts[:, 1] / h, 0, 1)\\n\\n    coords = \\\u0022 \\\u0022.join(f\\\u0022{v:.6f}\\\u0022 for v in pts.flatten())\\n\\n    return f\\\u0022{cls_id} {coords}\\\u0022\\n\\n\\ndef build_yolo_split(split_name, image_ids):\\n\\n    img_dir = os.path.join(CFG.YOLO_DIR, \\\u0022images\\\u0022, split_name)\\n    lbl_dir = os.path.join(CFG.YOLO_DIR, \\\u0022labels\\\u0022, split_name)\\n\\n    os.makedirs(img_dir, exist_ok=True)\\n    os.makedirs(lbl_dir, exist_ok=True)\\n\\n    n_skipped = 0\\n\\n    for image_id in image_ids:\\n\\n        info = images[image_id]\\n        h, w = info[\\\u0022height\\\u0022], info[\\\u0022width\\\u0022]\\n        stem = os.path.splitext(info[\\\u0022file_name\\\u0022])[0]\\n\\n        src = os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022])\\n        dst = os.path.join(img_dir, info[\\\u0022file_name\\\u0022])\\n\\n        if not os.path.exists(dst):\\n            os.symlink(src, dst)\\n\\n        lines = []\\n\\n        for ann in annotations.get(image_id, []):\\n\\n            if ann.get(\\\u0022iscrowd\\\u0022, 0):\\n                n_skipped += 1\\n                continue\\n\\n            if cat_id_to_yolo is not None:\\n                cls_id = cat_id_to_yolo[ann[\\\u0022category_id\\\u0022]]\\n            else:\\n                cls_id = 0\\n\\n            for polygon in ann[\\\u0022segmentation\\\u0022]:\\n\\n                if len(polygon) \u003c 6:\\n                    n_skipped += 1\\n                    continue\\n\\n                lines.append(\\n                    coco_polygon_to_yolo_line(polygon, w, h, cls_id)\\n                )\\n\\n        with open(os.path.join(lbl_dir, stem + \\\u0022.txt\\\u0022), \\\u0022w\\\u0022) as f:\\n            f.write(\\\u0022\\\\n\\\u0022.join(lines))\\n\\n    return n_skipped\\n\\n\\nn_skip_train = build_yolo_split(\\\u0022train\\\u0022, train_ids)\\nn_skip_valid = build_yolo_split(\\\u0022val\\\u0022, valid_ids)\\n\\nprint(f\\\u0022Skipped (iscrowd/degenerate): train={n_skip_train}, val={n_skip_valid}\\\u0022)\\n\\nnames_yaml = \\\u0022\\\\n\\\u0022.join(f\\\u0022  {i}: {name}\\\u0022 for i, name in enumerate(class_names))\\n\\ndata_yaml = f\\\u0022\\\u0022\\\u0022path: {CFG.YOLO_DIR}\\ntrain: images/train\\nval: images/val\\nnames:\\n{names_yaml}\\n\\\u0022\\\u0022\\\u0022\\n\\nwith open(os.path.join(CFG.YOLO_DIR, \\\u0022data.yaml\\\u0022), \\\u0022w\\\u0022) as f:\\n    f.write(data_yaml)\\n\\nprint(\\\u0022YOLO dataset ready:\\\u0022, CFG.YOLO_DIR)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.560926Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.561326Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:30.851159Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.561288Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:30.850463Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022_n_gpu = torch.cuda.device_count()\\nif _n_gpu \u003e 1:\\n    CFG.DEVICE = \\\u0022,\\\u0022.join(str(i) for i in range(_n_gpu))\\nelif _n_gpu == 1:\\n    CFG.DEVICE = 0\\nelse:\\n    CFG.DEVICE = \\\u0022cpu\\\u0022\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:30.852799Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:30.853132Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:30.888643Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:30.853111Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:30.888097Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Train\\n# ====================================================\\n\\nmodel = YOLO(CFG.MODEL)\\n\\nmodel.train(\\n    data=os.path.join(CFG.YOLO_DIR, \\\u0022data.yaml\\\u0022),\\n    epochs=CFG.EPOCHS,\\n    imgsz=CFG.IMGSZ,\\n    batch=CFG.BATCH_SIZE,\\n    device=CFG.DEVICE,\\n    patience=CFG.PATIENCE,\\n    seed=CFG.SEED,\\n    single_cls=(not CFG.USE_CATEGORIES),\\n    mask_ratio=CFG.MASK_RATIO,\\n    overlap_mask=False,\\n    hsv_h=0.0,\\n    hsv_s=0.0,\\n    fliplr=0.0,\\n    flipud=0.0,\\n\\n    mosaic=0.3,\\n    degrees=10,\\n    scale=0.3,\\n    hsv_v=0.3,\\n    close_mosaic=5,\\n\\n    project=\\\u0022runs_filament\\\u0022,\\n    name=\\\u0022yolo_seg_aug_test\\\u0022,\\n)\\n\\nimport shutil\\n\\nbest_weights_path = str(model.trainer.best)\\nshutil.copy(best_weights_path, \\\u0022best_model.pt\\\u0022)\\n\\nprint(\\\u0022Best weights:\\\u0022, best_weights_path, \\\u0022-\u003e saved as best_model.pt\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:30.890626Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:30.890835Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:32:37.012826Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:30.890817Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:32:37.012092Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Crop-refiner: light UNet over instances, found by YOLO\\n# ============================================================\\nimport torch\\nimport torch.nn as nn\\nfrom torch.utils.data import Dataset, DataLoader\\nfrom torchvision.models import resnet18, ResNet18_Weights\\nimport numpy as np\\nimport cv2\\nimport random\\nimport os\\nfrom tqdm.auto import tqdm\\n\\nCROP_SIZE = 256\\nCONTEXT = 1.8\\nMIN_CROP = 96\\n\\n\\ndef square_bounds(mask, context=CONTEXT, minimum=MIN_CROP):\\n    height, width = mask.shape\\n    ys, xs = np.where(mask)\\n    if len(xs) == 0:\\n        return 0, 0, width, height\\n    cx, cy = (xs.min() + xs.max() + 1) / 2, (ys.min() + ys.max() + 1) / 2\\n    side = int(np.ceil(max(xs.max() - xs.min() + 1, ys.max() - ys.min() + 1) * context))\\n    side = min(max(side, minimum), min(height, width))\\n    x0, y0 = int(round(cx - side / 2)), int(round(cy - side / 2))\\n    x1, y1 = x0 + side, y0 + side\\n    if x0 \u003c 0: x1 -= x0; x0 = 0\\n    if y0 \u003c 0: y1 -= y0; y0 = 0\\n    if x1 \u003e width: x0 -= x1 - width; x1 = width\\n    if y1 \u003e height: y0 -= y1 - height; y1 = height\\n    return int(x0), int(y0), int(x1), int(y1)\\n\\n\\nclass ConvBlock(nn.Sequential):\\n    def __init__(self, in_ch, out_ch):\\n        super().__init__(\\n            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False), nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\\n            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False), nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\\n        )\\n\\n\\nclass CropUNet(nn.Module):\\n\\n    def __init__(self, pretrained=True):\\n        super().__init__()\\n        enc = resnet18(weights=ResNet18_Weights.DEFAULT if pretrained else None)\\n        self.stem = nn.Sequential(enc.conv1, enc.bn1, enc.relu)\\n        self.pool, self.layer1, self.layer2, self.layer3, self.layer4 = (\\n            enc.maxpool, enc.layer1, enc.layer2, enc.layer3, enc.layer4\\n        )\\n        self.up4, self.dec4 = nn.ConvTranspose2d(512, 256, 2, 2), ConvBlock(512, 256)\\n        self.up3, self.dec3 = nn.ConvTranspose2d(256, 128, 2, 2), ConvBlock(256, 128)\\n        self.up2, self.dec2 = nn.ConvTranspose2d(128, 64, 2, 2), ConvBlock(128, 64)\\n        self.up1, self.dec1 = nn.ConvTranspose2d(64, 32, 2, 2), ConvBlock(96, 32)\\n        self.up0, self.head = nn.ConvTranspose2d(32, 16, 2, 2), nn.Conv2d(16, 1, 1)\\n        self.register_buffer(\\\u0022mean\\\u0022, torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\\n        self.register_buffer(\\\u0022std\\\u0022, torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\\n\\n    def forward(self, image):\\n        image = (image - self.mean) / self.std\\n        x0 = self.stem(image)\\n        x1 = self.layer1(self.pool(x0))\\n        x2 = self.layer2(x1)\\n        x3 = self.layer3(x2)\\n        x4 = self.layer4(x3)\\n        x = self.dec4(torch.cat([self.up4(x4), x3], 1))\\n        x = self.dec3(torch.cat([self.up3(x), x2], 1))\\n        x = self.dec2(torch.cat([self.up2(x), x1], 1))\\n        x = self.dec1(torch.cat([self.up1(x), x0], 1))\\n        return self.head(self.up0(x))\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:32:37.01398Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:32:37.014511Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:32:37.142766Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:32:37.014485Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:32:37.142117Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Crop cash from GT-labels (train_ids/valid_ids from YOLO-conversion)\\n# ============================================================\\n\\ndef build_crop_arrays(image_ids):\\n    imgs, masks = [], []\\n    for image_id in tqdm(image_ids, desc=\\\u0022building crops\\\u0022):\\n        info = images[image_id]\\n        image = cv2.imread(os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022]), cv2.IMREAD_GRAYSCALE)\\n        for ann in annotations.get(image_id, []):\\n            m = np.zeros(image.shape, dtype=np.uint8)\\n            for polygon in ann[\\\u0022segmentation\\\u0022]:\\n                pts = np.round(np.array(polygon, dtype=np.float32).reshape(-1, 2)).astype(np.int32)\\n                cv2.fillPoly(m, [pts], 1)\\n            if m.sum() == 0:\\n                continue\\n            x0, y0, x1, y1 = square_bounds(m)\\n            imgs.append(cv2.resize(image[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_LINEAR))\\n            masks.append(cv2.resize(m[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_NEAREST))\\n    return np.stack(imgs), np.stack(masks)\\n\\n\\ntrain_crop_images, train_crop_masks = build_crop_arrays(train_ids)\\nvalid_crop_images, valid_crop_masks = build_crop_arrays(valid_ids)\\nprint(f\\\u0022train crops: {len(train_crop_images)}, valid crops: {len(valid_crop_images)}\\\u0022)\\n\\n\\nclass CropDataset(Dataset):\\n    def __init__(self, imgs, masks, augment=False):\\n        self.imgs, self.masks, self.augment = imgs, masks, augment\\n\\n    def __len__(self):\\n        return len(self.imgs)\\n\\n    def __getitem__(self, idx):\\n        image = torch.from_numpy(self.imgs[idx].copy()).float() / 255\\n        mask = torch.from_numpy(self.masks[idx].copy()).float().unsqueeze(0)\\n\\n        if self.augment:\\n            k = random.randrange(4)\\n            image, mask = torch.rot90(image, k, (0, 1)), torch.rot90(mask, k, (1, 2))\\n            if random.random() \u003c 0.5:\\n                image, mask = torch.flip(image, (1,)), torch.flip(mask, (2,))\\n            if random.random() \u003c 0.5:\\n                image = image ** random.uniform(0.85, 1.20)  # gamma jitter\\n            if random.random() \u003c 0.5:\\n                image = torch.clamp(image * random.uniform(0.90, 1.10), 0, 1)  # gain jitter\\n\\n        return image.unsqueeze(0).repeat(3, 1, 1), mask\\n\\n\\ntrain_crop_loader = DataLoader(CropDataset(train_crop_images, train_crop_masks, augment=True),\\n                                batch_size=16, shuffle=True, num_workers=2, pin_memory=True)\\nvalid_crop_loader = DataLoader(CropDataset(valid_crop_images, valid_crop_masks, augment=False),\\n                                batch_size=32, shuffle=False, num_workers=2, pin_memory=True)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:32:37.143716Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:32:37.144253Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:34:37.660508Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:32:37.144222Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:34:37.659584Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Train\\n# ============================================================\\n\\ndef soft_dice_loss(logits, targets):\\n    probs = logits.sigmoid()\\n    inter = (probs * targets).sum((1, 2, 3))\\n    denom = probs.sum((1, 2, 3)) + targets.sum((1, 2, 3))\\n    return (1 - (2 * inter + 1) / (denom + 1)).mean()\\n\\n\\ndef train_refiner(model, train_loader, valid_loader, epochs, out_path):\\n    device = torch.device(\\\u0022cuda:0\\\u0022 if torch.cuda.is_available() else \\\u0022cpu\\\u0022)\\n    model.to(device)\\n    optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-4)\\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)\\n    scaler = torch.amp.GradScaler(\\\u0022cuda\\\u0022, enabled=torch.cuda.is_available())\\n    best_dice = -1\\n\\n    for epoch in range(1, epochs + 1):\\n        model.train()\\n        for imgs, masks in tqdm(train_loader, desc=f\\\u0022refiner epoch {epoch}/{epochs}\\\u0022, leave=False):\\n            imgs, masks = imgs.to(device), masks.to(device)\\n            optimizer.zero_grad(set_to_none=True)\\n            with torch.amp.autocast(\\\u0022cuda\\\u0022, enabled=torch.cuda.is_available()):\\n                logits = model(imgs)\\n                loss = 0.5 * nn.functional.binary_cross_entropy_with_logits(logits, masks) + 0.5 * soft_dice_loss(logits, masks)\\n            scaler.scale(loss).backward()\\n            scaler.step(optimizer)\\n            scaler.update()\\n\\n        model.eval()\\n        dice_sum = n = 0\\n        with torch.no_grad():\\n            for imgs, masks in valid_loader:\\n                imgs, masks = imgs.to(device), masks.to(device).bool()\\n                pred = model(imgs).sigmoid() \u003e= 0.65\\n                inter = (pred \u0026 masks).sum((1, 2, 3)).float()\\n                denom = pred.sum((1, 2, 3)) + masks.sum((1, 2, 3))\\n                dice_sum += ((2 * inter + 1e-7) / (denom + 1e-7)).sum().item()\\n                n += len(imgs)\\n        val_dice = dice_sum / n\\n        print(f\\\u0022epoch {epoch}: val_dice={val_dice:.4f}\\\u0022)\\n\\n        if val_dice \u003e best_dice:\\n            best_dice = val_dice\\n            torch.save(model.state_dict(), out_path)\\n\\n        scheduler.step()\\n\\n    return best_dice\\n\\n\\nrefiner = CropUNet(pretrained=True)\\nbest_refiner_dice = train_refiner(refiner, train_crop_loader, valid_crop_loader, epochs=8, out_path=\\\u0022best_refiner.pt\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:34:37.661655Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:34:37.662091Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:01.994718Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:34:37.662047Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:01.993776Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Inference: YOLO finds instacnes -\u003e refiner adds details\\n# ============================================================\\n\\ndevice = torch.device(\\\u0022cuda:0\\\u0022 if torch.cuda.is_available() else \\\u0022cpu\\\u0022)\\nrefiner = CropUNet(pretrained=False)\\nrefiner.load_state_dict(torch.load(\\\u0022best_refiner.pt\\\u0022, map_location=device))\\nrefiner.to(device).eval()\\nREFINER_THRESHOLD = 0.65\\n\\n\\n@torch.no_grad()\\ndef refine_masks(image_gray, yolo_masks, refiner, device, threshold=REFINER_THRESHOLD):\\n    refined = []\\n    for mask in yolo_masks:\\n        if mask.sum() == 0:\\n            refined.append(mask)\\n            continue\\n        x0, y0, x1, y1 = square_bounds(mask)\\n        crop = cv2.resize(image_gray[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_LINEAR)\\n        tensor = torch.from_numpy(crop).float().unsqueeze(0).unsqueeze(0).repeat(1, 3, 1, 1).to(device) / 255\\n        prob = refiner(tensor).sigmoid()[0, 0].cpu().numpy()\\n        crop_mask = cv2.resize(prob, (x1 - x0, y1 - y0), interpolation=cv2.INTER_LINEAR) \u003e= threshold\\n\\n        if crop_mask.any():\\n            full = np.zeros_like(mask)\\n            full[y0:y1, x0:x1] = crop_mask\\n            refined.append(full)\\n        else:\\n            refined.append(mask)\\n\\n    return refined\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:01.997038Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:01.99734Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:02.294374Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:01.997301Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:02.293352Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import cv2\\n\\ndef build_full_mask(image_id, images, annotations):\\n\\n    info = images[image_id]\\n    h, w = info[\\\u0022height\\\u0022], info[\\\u0022width\\\u0022]\\n\\n    mask = np.zeros((h, w), dtype=np.uint8)\\n\\n    for ann in annotations.get(image_id, []):\\n\\n        for polygon in ann[\\\u0022segmentation\\\u0022]:\\n\\n            pts = np.array(polygon, dtype=np.float32).reshape(-1, 2)\\n            pts = np.round(pts).astype(np.int32)\\n\\n            cv2.fillPoly(mask, [pts], 1)\\n\\n    return mask\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:02.295622Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:02.296006Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:02.30136Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:02.295971Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:02.30062Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import matplotlib.pyplot as plt\\nimport cv2\\nimport numpy as np\\nimport random\\n\\nbest_model = YOLO(\\\u0022best_model.pt\\\u0022)\\n\\nN_SAMPLES = 4\\nsample_ids = random.sample(list(valid_ids), min(N_SAMPLES, len(valid_ids)))\\n\\nfig, axes = plt.subplots(2, N_SAMPLES, figsize=(6 * N_SAMPLES, 11))\\n\\n\\ndef overlay_vs_gt(img_rgb, gt_mask, pred_masks, min_size):\\n\\n    pred_union = np.zeros_like(gt_mask)\\n    for m in pred_masks:\\n        if m.sum() \u003e= min_size:\\n            pred_union = np.maximum(pred_union, m)\\n\\n    gt_bool, pred_bool = gt_mask.astype(bool), pred_union.astype(bool)\\n\\n    overlay = img_rgb.copy()\\n    overlay[gt_bool \u0026 pred_bool] = [0, 255, 0]\\n    overlay[gt_bool \u0026 ~pred_bool] = [255, 255, 0]\\n    overlay[~gt_bool \u0026 pred_bool] = [255, 0, 0] \\n\\n    return cv2.addWeighted(img_rgb, 0.4, overlay, 0.6, 0), len(pred_masks)\\n\\n\\nfor col, image_id in enumerate(sample_ids):\\n\\n    info = images[image_id]\\n    image_path = os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022])\\n\\n    img_gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\\n    img_rgb = cv2.cvtColor(img_gray, cv2.COLOR_GRAY2RGB)\\n\\n    gt_mask = build_full_mask(image_id, images, annotations)\\n\\n    r = best_model.predict(\\n        image_path, imgsz=CFG.IMGSZ, conf=CFG.CONF_THRESHOLD,\\n        agnostic_nms=True, retina_masks=True, verbose=False\\n    )[0]\\n\\n    yolo_masks = [m.cpu().numpy().astype(np.uint8) for m in r.masks.data] if r.masks is not None else []\\n    refined_masks = refine_masks(img_gray, yolo_masks, refiner, device) if yolo_masks else []\\n\\n    # --- строка 1: YOLO without refiner ---\\n    blended_yolo, n_yolo = overlay_vs_gt(img_rgb, gt_mask, yolo_masks, CFG.MIN_COMPONENT_SIZE)\\n    axes[0, col].imshow(blended_yolo)\\n    axes[0, col].set_title(f\\\u0022{info[\u0027file_name\u0027]}\\\\nYOLO only | GT:{len(cv2.findContours(gt_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)[0])} Pred:{n_yolo}\\\u0022, fontsize=9)\\n    axes[0, col].axis(\\\u0022off\\\u0022)\\n\\n    # --- строка 2: YOLO + refiner ---\\n    blended_refined, n_refined = overlay_vs_gt(img_rgb, gt_mask, refined_masks, CFG.MIN_COMPONENT_SIZE)\\n    axes[1, col].imshow(blended_refined)\\n    axes[1, col].set_title(f\\\u0022+ refiner | Pred:{n_refined}\\\u0022, fontsize=9)\\n    axes[1, col].axis(\\\u0022off\\\u0022)\\n\\nplt.tight_layout()\\nplt.savefig(\\\u0022visual_audit_refiner.png\\\u0022, dpi=120)\\nplt.show()\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:02.302568Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:02.302928Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:20.882727Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:02.302881Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:20.88156Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import pandas as pd\\nfrom pycocotools import mask as mask_utils\\n\\nrefiner = CropUNet(pretrained=False)\\nrefiner.load_state_dict(torch.load(\\\u0022best_refiner.pt\\\u0022, map_location=device))\\nrefiner.to(device).eval()\\n\\ntest_files = sorted([\\n    f for f in os.listdir(CFG.TEST_DIR)\\n    if f.endswith(\\\u0022.jpeg\\\u0022)\\n])\\n\\nrows = []\\n\\nfor filename in tqdm(test_files, desc=\\\u0022YOLO + refiner inference\\\u0022):\\n\\n    image_path = os.path.join(CFG.TEST_DIR, filename)\\n    image_gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\\n\\n    r = best_model.predict(\\n        image_path,\\n        imgsz=CFG.IMGSZ,\\n        conf=CFG.CONF_THRESHOLD,\\n        agnostic_nms=True,\\n        retina_masks=True,\\n        verbose=False\\n    )[0]\\n\\n    if r.masks is None:\\n        continue\\n\\n    yolo_masks = [m.cpu().numpy().astype(np.uint8) for m in r.masks.data]\\n\\n    refined = refine_masks(image_gray, yolo_masks, refiner, device)\\n\\n    image_id = filename.replace(\\\u0022.jpeg\\\u0022, \\\u0022\\\u0022)\\n    counter = 1\\n\\n    for mask in refined:\\n\\n        if mask.sum() \u003c CFG.MIN_COMPONENT_SIZE:\\n            continue\\n\\n        rle = mask_utils.encode(np.asfortranarray(mask.astype(np.uint8)))\\n\\n        rows.append({\\n            \\\u0022filament_id\\\u0022: f\\\u0022{image_id}_{counter}\\\u0022,\\n            \\\u0022segmentation_rle\\\u0022: rle[\\\u0022counts\\\u0022].decode(\\\u0022utf-8\\\u0022)\\n        })\\n\\n        counter += 1\\n\\nsubmission = pd.DataFrame(rows)\\nsubmission.to_csv(\\\u0022submission.csv\\\u0022, index=False)\\n\\nprint(submission.head())\\nprint(f\\\u0022Total predicted filaments: {len(submission)}\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:20.884004Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:20.884419Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:36:24.940113Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:20.88438Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:36:24.939293Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null}]}","languageNullable":"python","kernelTypeNullable":"notebook","slugNullable":"yolo-u-net-solar-filament-segmentation","source":"{\u0022metadata\u0022:{\u0022kernelspec\u0022:{\u0022display_name\u0022:\u0022Python 3\u0022,\u0022language\u0022:\u0022python\u0022,\u0022name\u0022:\u0022python3\u0022},\u0022language_info\u0022:{\u0022name\u0022:\u0022python\u0022,\u0022version\u0022:\u00223.12.13\u0022,\u0022mimetype\u0022:\u0022text/x-python\u0022,\u0022codemirror_mode\u0022:{\u0022name\u0022:\u0022ipython\u0022,\u0022version\u0022:3},\u0022pygments_lexer\u0022:\u0022ipython3\u0022,\u0022nbconvert_exporter\u0022:\u0022python\u0022,\u0022file_extension\u0022:\u0022.py\u0022}},\u0022nbformat_minor\u0022:4,\u0022nbformat\u0022:4,\u0022cells\u0022:[{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022%pip install -q ultralytics\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:15.487107Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:15.487377Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:21.328202Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:15.487343Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:21.327099Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Imports\\n# ====================================================\\n\\nimport os\\nimport json\\nimport random\\nimport warnings\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom sklearn.model_selection import train_test_split\\nfrom tqdm.auto import tqdm\\n\\nimport torch\\nfrom ultralytics import YOLO\\nfrom pycocotools import mask as mask_utils\\n\\nwarnings.filterwarnings(\\\u0022ignore\\\u0022)\\n\\nimport ultralytics.utils.tqdm as ultra_tqdm\\nultra_tqdm.is_noninteractive_console = lambda: True\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:21.330302Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:21.330544Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.273106Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:21.330516Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.272464Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Config\\n# ====================================================\\n\\nclass CFG:\\n\\n    ROOT = \\\u0022/kaggle/input/competitions/filament-segmentation-2026/MAGFiLO_1.0_Kaggle_2026\\\u0022\\n\\n    TRAIN_DIR = os.path.join(ROOT, \\\u0022train\\\u0022, \\\u0022train_images\\\u0022)\\n    TEST_DIR = os.path.join(ROOT, \\\u0022test\\\u0022, \\\u0022test_images\\\u0022)\\n\\n    TRAIN_JSON = os.path.join(\\n        ROOT,\\n        \\\u0022train\\\u0022,\\n        \\\u0022MAGFiLO_1.0_Annotations_kaggle2026_train.json\\\u0022\\n    )\\n\\n    YOLO_DIR = \\\u0022/kaggle/working/yolo_dataset\\\u0022\\n\\n    DEVICE = 0 if torch.cuda.is_available() else \\\u0022cpu\\\u0022\\n    DEBUG = False\\n\\n    IMGSZ = 1024\\n    BATCH_SIZE = 4\\n    EPOCHS = 1 if DEBUG else 30\\n    PATIENCE = 5\\n\\n    MODEL = \\\u0022yolo11s-seg.pt\\\u0022\\n\\n    USE_CATEGORIES = True\\n\\n    MASK_RATIO = 2\\n\\n    CONF_THRESHOLD = 0.25\\n    MIN_COMPONENT_SIZE = 20\\n\\n    SEED = 42\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.274101Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.27456Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.539601Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.274535Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.538606Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Seed\\n# ====================================================\\n\\ndef seed_everything(seed):\\n    random.seed(seed)\\n    np.random.seed(seed)\\n    torch.manual_seed(seed)\\n    if torch.cuda.is_available():\\n        torch.cuda.manual_seed_all(seed)\\n\\n\\nseed_everything(CFG.SEED)\\n\\nprint(f\\\u0022Device: {CFG.DEVICE}\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.54107Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.541467Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:29.559706Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.541445Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:29.558853Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# COCO -\u003e YOLO-seg conversion\\n# ====================================================\\n\\nwith open(CFG.TRAIN_JSON, \\\u0022r\\\u0022) as f:\\n    coco = json.load(f)\\n\\nimages = {img[\\\u0022id\\\u0022]: img for img in coco[\\\u0022images\\\u0022]}\\n\\nannotations = {}\\n\\nfor ann in coco[\\\u0022annotations\\\u0022]:\\n    annotations.setdefault(ann[\\\u0022image_id\\\u0022], []).append(ann)\\n\\nfile_to_ids = {}\\n\\nfor image_id, info in images.items():\\n    file_to_ids.setdefault(info[\\\u0022file_name\\\u0022], []).append(image_id)\\n\\nunique_files = list(file_to_ids.keys())\\n\\ndef observation_completeness(image_id):\\n    anns = annotations.get(image_id, [])\\n    total_area = sum(ann.get(\\\u0022area\\\u0022, 0) for ann in anns)\\n    return (len(anns), total_area)\\n\\nfile_to_best_id = {\\n    file_name: max(ids, key=observation_completeness)\\n    for file_name, ids in file_to_ids.items()\\n}\\n\\nn_duplicated = sum(1 for ids in file_to_ids.values() if len(ids) \u003e 1)\\nprint(f\\\u0022Instances with multiple labelers: \\\u0022\\n      f\\\u0022{n_duplicated} / {len(file_to_ids)}\\\u0022)\\n\\nunique_files = list(file_to_best_id.keys())\\n\\ntrain_files, valid_files = train_test_split(\\n    unique_files,\\n    test_size=0.2,\\n    random_state=CFG.SEED\\n)\\n\\ntrain_ids = [file_to_best_id[f] for f in train_files]\\nvalid_ids = [file_to_best_id[f] for f in valid_files]\\n\\nprint(f\\\u0022Train images: {len(train_ids)}\\\u0022)\\nprint(f\\\u0022Valid images: {len(valid_ids)}\\\u0022)\\n\\n\\nif CFG.USE_CATEGORIES and \\\u0022categories\\\u0022 in coco and coco[\\\u0022categories\\\u0022]:\\n\\n    categories = sorted(coco[\\\u0022categories\\\u0022], key=lambda c: c[\\\u0022id\\\u0022])\\n    cat_id_to_yolo = {c[\\\u0022id\\\u0022]: i for i, c in enumerate(categories)}\\n    class_names = [c[\\\u0022name\\\u0022] for c in categories]\\n\\nelse:\\n\\n    cat_id_to_yolo = None\\n    class_names = [\\\u0022filament\\\u0022]\\n\\nprint(\\\u0022Classes:\\\u0022, class_names)\\n\\n\\ndef coco_polygon_to_yolo_line(polygon, w, h, cls_id):\\n\\n    pts = np.array(polygon, dtype=np.float32).reshape(-1, 2)\\n\\n    pts[:, 0] = np.clip(pts[:, 0] / w, 0, 1)\\n    pts[:, 1] = np.clip(pts[:, 1] / h, 0, 1)\\n\\n    coords = \\\u0022 \\\u0022.join(f\\\u0022{v:.6f}\\\u0022 for v in pts.flatten())\\n\\n    return f\\\u0022{cls_id} {coords}\\\u0022\\n\\n\\ndef build_yolo_split(split_name, image_ids):\\n\\n    img_dir = os.path.join(CFG.YOLO_DIR, \\\u0022images\\\u0022, split_name)\\n    lbl_dir = os.path.join(CFG.YOLO_DIR, \\\u0022labels\\\u0022, split_name)\\n\\n    os.makedirs(img_dir, exist_ok=True)\\n    os.makedirs(lbl_dir, exist_ok=True)\\n\\n    n_skipped = 0\\n\\n    for image_id in image_ids:\\n\\n        info = images[image_id]\\n        h, w = info[\\\u0022height\\\u0022], info[\\\u0022width\\\u0022]\\n        stem = os.path.splitext(info[\\\u0022file_name\\\u0022])[0]\\n\\n        src = os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022])\\n        dst = os.path.join(img_dir, info[\\\u0022file_name\\\u0022])\\n\\n        if not os.path.exists(dst):\\n            os.symlink(src, dst)\\n\\n        lines = []\\n\\n        for ann in annotations.get(image_id, []):\\n\\n            if ann.get(\\\u0022iscrowd\\\u0022, 0):\\n                n_skipped += 1\\n                continue\\n\\n            if cat_id_to_yolo is not None:\\n                cls_id = cat_id_to_yolo[ann[\\\u0022category_id\\\u0022]]\\n            else:\\n                cls_id = 0\\n\\n            for polygon in ann[\\\u0022segmentation\\\u0022]:\\n\\n                if len(polygon) \u003c 6:\\n                    n_skipped += 1\\n                    continue\\n\\n                lines.append(\\n                    coco_polygon_to_yolo_line(polygon, w, h, cls_id)\\n                )\\n\\n        with open(os.path.join(lbl_dir, stem + \\\u0022.txt\\\u0022), \\\u0022w\\\u0022) as f:\\n            f.write(\\\u0022\\\\n\\\u0022.join(lines))\\n\\n    return n_skipped\\n\\n\\nn_skip_train = build_yolo_split(\\\u0022train\\\u0022, train_ids)\\nn_skip_valid = build_yolo_split(\\\u0022val\\\u0022, valid_ids)\\n\\nprint(f\\\u0022Skipped (iscrowd/degenerate): train={n_skip_train}, val={n_skip_valid}\\\u0022)\\n\\nnames_yaml = \\\u0022\\\\n\\\u0022.join(f\\\u0022  {i}: {name}\\\u0022 for i, name in enumerate(class_names))\\n\\ndata_yaml = f\\\u0022\\\u0022\\\u0022path: {CFG.YOLO_DIR}\\ntrain: images/train\\nval: images/val\\nnames:\\n{names_yaml}\\n\\\u0022\\\u0022\\\u0022\\n\\nwith open(os.path.join(CFG.YOLO_DIR, \\\u0022data.yaml\\\u0022), \\\u0022w\\\u0022) as f:\\n    f.write(data_yaml)\\n\\nprint(\\\u0022YOLO dataset ready:\\\u0022, CFG.YOLO_DIR)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:29.560926Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:29.561326Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:30.851159Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:29.561288Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:30.850463Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022_n_gpu = torch.cuda.device_count()\\nif _n_gpu \u003e 1:\\n    CFG.DEVICE = \\\u0022,\\\u0022.join(str(i) for i in range(_n_gpu))\\nelif _n_gpu == 1:\\n    CFG.DEVICE = 0\\nelse:\\n    CFG.DEVICE = \\\u0022cpu\\\u0022\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:30.852799Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:30.853132Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:30:30.888643Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:30.853111Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:30:30.888097Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ====================================================\\n# Train\\n# ====================================================\\n\\nmodel = YOLO(CFG.MODEL)\\n\\nmodel.train(\\n    data=os.path.join(CFG.YOLO_DIR, \\\u0022data.yaml\\\u0022),\\n    epochs=CFG.EPOCHS,\\n    imgsz=CFG.IMGSZ,\\n    batch=CFG.BATCH_SIZE,\\n    device=CFG.DEVICE,\\n    patience=CFG.PATIENCE,\\n    seed=CFG.SEED,\\n    single_cls=(not CFG.USE_CATEGORIES),\\n    mask_ratio=CFG.MASK_RATIO,\\n    overlap_mask=False,\\n    hsv_h=0.0,\\n    hsv_s=0.0,\\n    fliplr=0.0,\\n    flipud=0.0,\\n\\n    mosaic=0.3,\\n    degrees=10,\\n    scale=0.3,\\n    hsv_v=0.3,\\n    close_mosaic=5,\\n\\n    project=\\\u0022runs_filament\\\u0022,\\n    name=\\\u0022yolo_seg_aug_test\\\u0022,\\n)\\n\\nimport shutil\\n\\nbest_weights_path = str(model.trainer.best)\\nshutil.copy(best_weights_path, \\\u0022best_model.pt\\\u0022)\\n\\nprint(\\\u0022Best weights:\\\u0022, best_weights_path, \\\u0022-\u003e saved as best_model.pt\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:30:30.890626Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:30:30.890835Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:32:37.012826Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:30:30.890817Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:32:37.012092Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Crop-refiner: light UNet over instances, found by YOLO\\n# ============================================================\\nimport torch\\nimport torch.nn as nn\\nfrom torch.utils.data import Dataset, DataLoader\\nfrom torchvision.models import resnet18, ResNet18_Weights\\nimport numpy as np\\nimport cv2\\nimport random\\nimport os\\nfrom tqdm.auto import tqdm\\n\\nCROP_SIZE = 256\\nCONTEXT = 1.8\\nMIN_CROP = 96\\n\\n\\ndef square_bounds(mask, context=CONTEXT, minimum=MIN_CROP):\\n    height, width = mask.shape\\n    ys, xs = np.where(mask)\\n    if len(xs) == 0:\\n        return 0, 0, width, height\\n    cx, cy = (xs.min() + xs.max() + 1) / 2, (ys.min() + ys.max() + 1) / 2\\n    side = int(np.ceil(max(xs.max() - xs.min() + 1, ys.max() - ys.min() + 1) * context))\\n    side = min(max(side, minimum), min(height, width))\\n    x0, y0 = int(round(cx - side / 2)), int(round(cy - side / 2))\\n    x1, y1 = x0 + side, y0 + side\\n    if x0 \u003c 0: x1 -= x0; x0 = 0\\n    if y0 \u003c 0: y1 -= y0; y0 = 0\\n    if x1 \u003e width: x0 -= x1 - width; x1 = width\\n    if y1 \u003e height: y0 -= y1 - height; y1 = height\\n    return int(x0), int(y0), int(x1), int(y1)\\n\\n\\nclass ConvBlock(nn.Sequential):\\n    def __init__(self, in_ch, out_ch):\\n        super().__init__(\\n            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False), nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\\n            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False), nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),\\n        )\\n\\n\\nclass CropUNet(nn.Module):\\n\\n    def __init__(self, pretrained=True):\\n        super().__init__()\\n        enc = resnet18(weights=ResNet18_Weights.DEFAULT if pretrained else None)\\n        self.stem = nn.Sequential(enc.conv1, enc.bn1, enc.relu)\\n        self.pool, self.layer1, self.layer2, self.layer3, self.layer4 = (\\n            enc.maxpool, enc.layer1, enc.layer2, enc.layer3, enc.layer4\\n        )\\n        self.up4, self.dec4 = nn.ConvTranspose2d(512, 256, 2, 2), ConvBlock(512, 256)\\n        self.up3, self.dec3 = nn.ConvTranspose2d(256, 128, 2, 2), ConvBlock(256, 128)\\n        self.up2, self.dec2 = nn.ConvTranspose2d(128, 64, 2, 2), ConvBlock(128, 64)\\n        self.up1, self.dec1 = nn.ConvTranspose2d(64, 32, 2, 2), ConvBlock(96, 32)\\n        self.up0, self.head = nn.ConvTranspose2d(32, 16, 2, 2), nn.Conv2d(16, 1, 1)\\n        self.register_buffer(\\\u0022mean\\\u0022, torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\\n        self.register_buffer(\\\u0022std\\\u0022, torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\\n\\n    def forward(self, image):\\n        image = (image - self.mean) / self.std\\n        x0 = self.stem(image)\\n        x1 = self.layer1(self.pool(x0))\\n        x2 = self.layer2(x1)\\n        x3 = self.layer3(x2)\\n        x4 = self.layer4(x3)\\n        x = self.dec4(torch.cat([self.up4(x4), x3], 1))\\n        x = self.dec3(torch.cat([self.up3(x), x2], 1))\\n        x = self.dec2(torch.cat([self.up2(x), x1], 1))\\n        x = self.dec1(torch.cat([self.up1(x), x0], 1))\\n        return self.head(self.up0(x))\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:32:37.01398Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:32:37.014511Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:32:37.142766Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:32:37.014485Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:32:37.142117Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Crop cash from GT-labels (train_ids/valid_ids from YOLO-conversion)\\n# ============================================================\\n\\ndef build_crop_arrays(image_ids):\\n    imgs, masks = [], []\\n    for image_id in tqdm(image_ids, desc=\\\u0022building crops\\\u0022):\\n        info = images[image_id]\\n        image = cv2.imread(os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022]), cv2.IMREAD_GRAYSCALE)\\n        for ann in annotations.get(image_id, []):\\n            m = np.zeros(image.shape, dtype=np.uint8)\\n            for polygon in ann[\\\u0022segmentation\\\u0022]:\\n                pts = np.round(np.array(polygon, dtype=np.float32).reshape(-1, 2)).astype(np.int32)\\n                cv2.fillPoly(m, [pts], 1)\\n            if m.sum() == 0:\\n                continue\\n            x0, y0, x1, y1 = square_bounds(m)\\n            imgs.append(cv2.resize(image[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_LINEAR))\\n            masks.append(cv2.resize(m[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_NEAREST))\\n    return np.stack(imgs), np.stack(masks)\\n\\n\\ntrain_crop_images, train_crop_masks = build_crop_arrays(train_ids)\\nvalid_crop_images, valid_crop_masks = build_crop_arrays(valid_ids)\\nprint(f\\\u0022train crops: {len(train_crop_images)}, valid crops: {len(valid_crop_images)}\\\u0022)\\n\\n\\nclass CropDataset(Dataset):\\n    def __init__(self, imgs, masks, augment=False):\\n        self.imgs, self.masks, self.augment = imgs, masks, augment\\n\\n    def __len__(self):\\n        return len(self.imgs)\\n\\n    def __getitem__(self, idx):\\n        image = torch.from_numpy(self.imgs[idx].copy()).float() / 255\\n        mask = torch.from_numpy(self.masks[idx].copy()).float().unsqueeze(0)\\n\\n        if self.augment:\\n            k = random.randrange(4)\\n            image, mask = torch.rot90(image, k, (0, 1)), torch.rot90(mask, k, (1, 2))\\n            if random.random() \u003c 0.5:\\n                image, mask = torch.flip(image, (1,)), torch.flip(mask, (2,))\\n            if random.random() \u003c 0.5:\\n                image = image ** random.uniform(0.85, 1.20)  # gamma jitter\\n            if random.random() \u003c 0.5:\\n                image = torch.clamp(image * random.uniform(0.90, 1.10), 0, 1)  # gain jitter\\n\\n        return image.unsqueeze(0).repeat(3, 1, 1), mask\\n\\n\\ntrain_crop_loader = DataLoader(CropDataset(train_crop_images, train_crop_masks, augment=True),\\n                                batch_size=16, shuffle=True, num_workers=2, pin_memory=True)\\nvalid_crop_loader = DataLoader(CropDataset(valid_crop_images, valid_crop_masks, augment=False),\\n                                batch_size=32, shuffle=False, num_workers=2, pin_memory=True)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:32:37.143716Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:32:37.144253Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:34:37.660508Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:32:37.144222Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:34:37.659584Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Train\\n# ============================================================\\n\\ndef soft_dice_loss(logits, targets):\\n    probs = logits.sigmoid()\\n    inter = (probs * targets).sum((1, 2, 3))\\n    denom = probs.sum((1, 2, 3)) + targets.sum((1, 2, 3))\\n    return (1 - (2 * inter + 1) / (denom + 1)).mean()\\n\\n\\ndef train_refiner(model, train_loader, valid_loader, epochs, out_path):\\n    device = torch.device(\\\u0022cuda:0\\\u0022 if torch.cuda.is_available() else \\\u0022cpu\\\u0022)\\n    model.to(device)\\n    optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-4)\\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)\\n    scaler = torch.amp.GradScaler(\\\u0022cuda\\\u0022, enabled=torch.cuda.is_available())\\n    best_dice = -1\\n\\n    for epoch in range(1, epochs + 1):\\n        model.train()\\n        for imgs, masks in tqdm(train_loader, desc=f\\\u0022refiner epoch {epoch}/{epochs}\\\u0022, leave=False):\\n            imgs, masks = imgs.to(device), masks.to(device)\\n            optimizer.zero_grad(set_to_none=True)\\n            with torch.amp.autocast(\\\u0022cuda\\\u0022, enabled=torch.cuda.is_available()):\\n                logits = model(imgs)\\n                loss = 0.5 * nn.functional.binary_cross_entropy_with_logits(logits, masks) + 0.5 * soft_dice_loss(logits, masks)\\n            scaler.scale(loss).backward()\\n            scaler.step(optimizer)\\n            scaler.update()\\n\\n        model.eval()\\n        dice_sum = n = 0\\n        with torch.no_grad():\\n            for imgs, masks in valid_loader:\\n                imgs, masks = imgs.to(device), masks.to(device).bool()\\n                pred = model(imgs).sigmoid() \u003e= 0.65\\n                inter = (pred \u0026 masks).sum((1, 2, 3)).float()\\n                denom = pred.sum((1, 2, 3)) + masks.sum((1, 2, 3))\\n                dice_sum += ((2 * inter + 1e-7) / (denom + 1e-7)).sum().item()\\n                n += len(imgs)\\n        val_dice = dice_sum / n\\n        print(f\\\u0022epoch {epoch}: val_dice={val_dice:.4f}\\\u0022)\\n\\n        if val_dice \u003e best_dice:\\n            best_dice = val_dice\\n            torch.save(model.state_dict(), out_path)\\n\\n        scheduler.step()\\n\\n    return best_dice\\n\\n\\nrefiner = CropUNet(pretrained=True)\\nbest_refiner_dice = train_refiner(refiner, train_crop_loader, valid_crop_loader, epochs=8, out_path=\\\u0022best_refiner.pt\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:34:37.661655Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:34:37.662091Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:01.994718Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:34:37.662047Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:01.993776Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022# ============================================================\\n# Inference: YOLO finds instacnes -\u003e refiner adds details\\n# ============================================================\\n\\ndevice = torch.device(\\\u0022cuda:0\\\u0022 if torch.cuda.is_available() else \\\u0022cpu\\\u0022)\\nrefiner = CropUNet(pretrained=False)\\nrefiner.load_state_dict(torch.load(\\\u0022best_refiner.pt\\\u0022, map_location=device))\\nrefiner.to(device).eval()\\nREFINER_THRESHOLD = 0.65\\n\\n\\n@torch.no_grad()\\ndef refine_masks(image_gray, yolo_masks, refiner, device, threshold=REFINER_THRESHOLD):\\n    refined = []\\n    for mask in yolo_masks:\\n        if mask.sum() == 0:\\n            refined.append(mask)\\n            continue\\n        x0, y0, x1, y1 = square_bounds(mask)\\n        crop = cv2.resize(image_gray[y0:y1, x0:x1], (CROP_SIZE, CROP_SIZE), interpolation=cv2.INTER_LINEAR)\\n        tensor = torch.from_numpy(crop).float().unsqueeze(0).unsqueeze(0).repeat(1, 3, 1, 1).to(device) / 255\\n        prob = refiner(tensor).sigmoid()[0, 0].cpu().numpy()\\n        crop_mask = cv2.resize(prob, (x1 - x0, y1 - y0), interpolation=cv2.INTER_LINEAR) \u003e= threshold\\n\\n        if crop_mask.any():\\n            full = np.zeros_like(mask)\\n            full[y0:y1, x0:x1] = crop_mask\\n            refined.append(full)\\n        else:\\n            refined.append(mask)\\n\\n    return refined\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:01.997038Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:01.99734Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:02.294374Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:01.997301Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:02.293352Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import cv2\\n\\ndef build_full_mask(image_id, images, annotations):\\n\\n    info = images[image_id]\\n    h, w = info[\\\u0022height\\\u0022], info[\\\u0022width\\\u0022]\\n\\n    mask = np.zeros((h, w), dtype=np.uint8)\\n\\n    for ann in annotations.get(image_id, []):\\n\\n        for polygon in ann[\\\u0022segmentation\\\u0022]:\\n\\n            pts = np.array(polygon, dtype=np.float32).reshape(-1, 2)\\n            pts = np.round(pts).astype(np.int32)\\n\\n            cv2.fillPoly(mask, [pts], 1)\\n\\n    return mask\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:02.295622Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:02.296006Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:02.30136Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:02.295971Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:02.30062Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import matplotlib.pyplot as plt\\nimport cv2\\nimport numpy as np\\nimport random\\n\\nbest_model = YOLO(\\\u0022best_model.pt\\\u0022)\\n\\nN_SAMPLES = 4\\nsample_ids = random.sample(list(valid_ids), min(N_SAMPLES, len(valid_ids)))\\n\\nfig, axes = plt.subplots(2, N_SAMPLES, figsize=(6 * N_SAMPLES, 11))\\n\\n\\ndef overlay_vs_gt(img_rgb, gt_mask, pred_masks, min_size):\\n\\n    pred_union = np.zeros_like(gt_mask)\\n    for m in pred_masks:\\n        if m.sum() \u003e= min_size:\\n            pred_union = np.maximum(pred_union, m)\\n\\n    gt_bool, pred_bool = gt_mask.astype(bool), pred_union.astype(bool)\\n\\n    overlay = img_rgb.copy()\\n    overlay[gt_bool \u0026 pred_bool] = [0, 255, 0]\\n    overlay[gt_bool \u0026 ~pred_bool] = [255, 255, 0]\\n    overlay[~gt_bool \u0026 pred_bool] = [255, 0, 0] \\n\\n    return cv2.addWeighted(img_rgb, 0.4, overlay, 0.6, 0), len(pred_masks)\\n\\n\\nfor col, image_id in enumerate(sample_ids):\\n\\n    info = images[image_id]\\n    image_path = os.path.join(CFG.TRAIN_DIR, info[\\\u0022file_name\\\u0022])\\n\\n    img_gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\\n    img_rgb = cv2.cvtColor(img_gray, cv2.COLOR_GRAY2RGB)\\n\\n    gt_mask = build_full_mask(image_id, images, annotations)\\n\\n    r = best_model.predict(\\n        image_path, imgsz=CFG.IMGSZ, conf=CFG.CONF_THRESHOLD,\\n        agnostic_nms=True, retina_masks=True, verbose=False\\n    )[0]\\n\\n    yolo_masks = [m.cpu().numpy().astype(np.uint8) for m in r.masks.data] if r.masks is not None else []\\n    refined_masks = refine_masks(img_gray, yolo_masks, refiner, device) if yolo_masks else []\\n\\n    # --- строка 1: YOLO without refiner ---\\n    blended_yolo, n_yolo = overlay_vs_gt(img_rgb, gt_mask, yolo_masks, CFG.MIN_COMPONENT_SIZE)\\n    axes[0, col].imshow(blended_yolo)\\n    axes[0, col].set_title(f\\\u0022{info[\u0027file_name\u0027]}\\\\nYOLO only | GT:{len(cv2.findContours(gt_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)[0])} Pred:{n_yolo}\\\u0022, fontsize=9)\\n    axes[0, col].axis(\\\u0022off\\\u0022)\\n\\n    # --- строка 2: YOLO + refiner ---\\n    blended_refined, n_refined = overlay_vs_gt(img_rgb, gt_mask, refined_masks, CFG.MIN_COMPONENT_SIZE)\\n    axes[1, col].imshow(blended_refined)\\n    axes[1, col].set_title(f\\\u0022+ refiner | Pred:{n_refined}\\\u0022, fontsize=9)\\n    axes[1, col].axis(\\\u0022off\\\u0022)\\n\\nplt.tight_layout()\\nplt.savefig(\\\u0022visual_audit_refiner.png\\\u0022, dpi=120)\\nplt.show()\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:02.302568Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:02.302928Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:35:20.882727Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:02.302881Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:35:20.88156Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null},{\u0022cell_type\u0022:\u0022code\u0022,\u0022source\u0022:\u0022import pandas as pd\\nfrom pycocotools import mask as mask_utils\\n\\nrefiner = CropUNet(pretrained=False)\\nrefiner.load_state_dict(torch.load(\\\u0022best_refiner.pt\\\u0022, map_location=device))\\nrefiner.to(device).eval()\\n\\ntest_files = sorted([\\n    f for f in os.listdir(CFG.TEST_DIR)\\n    if f.endswith(\\\u0022.jpeg\\\u0022)\\n])\\n\\nrows = []\\n\\nfor filename in tqdm(test_files, desc=\\\u0022YOLO + refiner inference\\\u0022):\\n\\n    image_path = os.path.join(CFG.TEST_DIR, filename)\\n    image_gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\\n\\n    r = best_model.predict(\\n        image_path,\\n        imgsz=CFG.IMGSZ,\\n        conf=CFG.CONF_THRESHOLD,\\n        agnostic_nms=True,\\n        retina_masks=True,\\n        verbose=False\\n    )[0]\\n\\n    if r.masks is None:\\n        continue\\n\\n    yolo_masks = [m.cpu().numpy().astype(np.uint8) for m in r.masks.data]\\n\\n    refined = refine_masks(image_gray, yolo_masks, refiner, device)\\n\\n    image_id = filename.replace(\\\u0022.jpeg\\\u0022, \\\u0022\\\u0022)\\n    counter = 1\\n\\n    for mask in refined:\\n\\n        if mask.sum() \u003c CFG.MIN_COMPONENT_SIZE:\\n            continue\\n\\n        rle = mask_utils.encode(np.asfortranarray(mask.astype(np.uint8)))\\n\\n        rows.append({\\n            \\\u0022filament_id\\\u0022: f\\\u0022{image_id}_{counter}\\\u0022,\\n            \\\u0022segmentation_rle\\\u0022: rle[\\\u0022counts\\\u0022].decode(\\\u0022utf-8\\\u0022)\\n        })\\n\\n        counter += 1\\n\\nsubmission = pd.DataFrame(rows)\\nsubmission.to_csv(\\\u0022submission.csv\\\u0022, index=False)\\n\\nprint(submission.head())\\nprint(f\\\u0022Total predicted filaments: {len(submission)}\\\u0022)\u0022,\u0022metadata\u0022:{\u0022trusted\u0022:true,\u0022execution\u0022:{\u0022iopub.status.busy\u0022:\u00222026-07-21T09:35:20.884004Z\u0022,\u0022iopub.execute_input\u0022:\u00222026-07-21T09:35:20.884419Z\u0022,\u0022iopub.status.idle\u0022:\u00222026-07-21T09:36:24.940113Z\u0022,\u0022shell.execute_reply.started\u0022:\u00222026-07-21T09:35:20.88438Z\u0022,\u0022shell.execute_reply\u0022:\u00222026-07-21T09:36:24.939293Z\u0022}},\u0022outputs\u0022:[],\u0022execution_count\u0022:null}]}","hasSource":true,"language":"python","hasLanguage":true,"kernelType":"notebook","hasKernelType":true,"slug":"yolo-u-net-solar-filament-segmentation","hasSlug":true}}